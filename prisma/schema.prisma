generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum Role {
  CUSTOMER
  ADMIN
}

enum LoginCodePurpose {
  REGISTRATION
  PASSWORD_RESET
}

enum Gender {
  MALE
  FEMALE
  UNISEX
}

enum UserGender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum DiscountType {
  PERCENT
  FIXED
}

enum ReviewStatus {
  PENDING
  APPROVED
  HIDDEN
}

enum OrderStatus {
  PENDING
  APPROVED
  REJECTED
  DISPATCHED
  OUT_FOR_DELIVERY
  DELIVERED
  DELIVERY_ATTEMPT_FAILED
}

enum InvoiceEmailStatus {
  PENDING
  SENDING
  SENT
  FAILED
}

enum PaymentMethod {
  CASH_ON_DELIVERY
  RAZORPAY
  PAYU
}

enum PaymentStatus {
  NOT_REQUIRED
  PENDING
  PAID
  FAILED
}

enum RazorpayAttemptStatus {
  CREATING
  CREATED
  AUTHORIZED
  CAPTURED
  FAILED
}

enum ContactFaqPage {
  CONTACT
  FAQ_PAGE
}

enum PartnerInterest {
  DISTRIBUTOR
  INFLUENCER_CREATOR
  OTHER
}

enum CareerJobRole {
  MARKETING
  SALES
  E_COMMERCE
  OPERATIONS
  OTHER
}

enum OrderDeliveryOutcome {
  DELIVERED
  DELIVERY_ATTEMPT_FAILED
}

model User {
  id                         String      @id @default(uuid())
  email                      String?     @unique
  username                   String?     @unique
  passwordHash               String?
  name                       String?
  phone                      String?     @db.VarChar(40)
  gender                     UserGender?
  dateOfBirth                DateTime?   @db.Date
  role                       Role        @default(CUSTOMER)
  accountDeletionRequestedAt DateTime?
  sessionVersion             Int         @default(0)
  createdAt                  DateTime    @default(now())
  updatedAt                  DateTime    @updatedAt

  cart           Cart?
  wishlist       WishlistItem[]
  orders         Order[]
  reviews        Review[]
  savedAddresses SavedAddress[]
}

model LoginCode {
  id        String           @id @default(uuid())
  email     String
  purpose   LoginCodePurpose @default(REGISTRATION)
  codeHash  String
  attempts  Int              @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([email, purpose, createdAt])
}

model Category {
  id             String     @id @default(uuid())
  name           String
  slug           String     @unique
  image          String
  description    String?    @db.Text
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  deletedAt      DateTime?
  products       Product[]
  discounts      Discount[]

  @@index([deletedAt])
}

model Brand {
  id        String    @id @default(uuid())
  name      String
  slug      String    @unique
  createdAt DateTime  @default(now())
  deletedAt DateTime?
  products  Product[]

  @@index([deletedAt])
}

model ProductType {
  id        String    @id @default(uuid())
  name      String
  slug      String    @unique
  createdAt DateTime  @default(now())
  deletedAt DateTime?
  products  Product[]

  @@index([deletedAt])
}

model Tag {
  id       String       @id @default(uuid())
  name     String
  slug     String       @unique
  products ProductTag[]
}

model Product {
  id                String    @id @default(uuid())
  slug              String    @unique @db.VarChar(255)
  shopifyId         String?   @unique @map("shopify_id") @db.VarChar(64)
  title             String    @db.VarChar(255)
  description       String    @db.Text
  images            Json
  aboutPoints       Json?
  aboutIntro        String?   @db.Text
  rawImages         Json?     @map("raw_images")
  price             Decimal   @db.Decimal(10, 2)
  currency          String    @default("INR")
  stock             Int       @default(0)
  gender            Gender    @default(UNISEX)
  rating            Decimal   @default(0) @db.Decimal(3, 2)
  reviewCount       Int       @default(0)
  soldCount         Int       @default(0)
  isActive          Boolean   @default(true)
  deletedAt         DateTime?
  deletedByTaxonomy Boolean   @default(false)
  seoTitle          String?
  seoDescription    String?
  categoryId        String
  brandId           String?
  productTypeId     String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  category    Category         @relation(fields: [categoryId], references: [id])
  brand       Brand?           @relation(fields: [brandId], references: [id])
  productType ProductType?     @relation(fields: [productTypeId], references: [id])
  variants    ProductVariant[]
  tags        ProductTag[]
  discounts   Discount[]
  reviews     Review[]
  cartItems   CartItem[]
  wishlist    WishlistItem[]
  orderItems  OrderItem[]

  @@index([categoryId])
  @@index([brandId])
  @@index([productTypeId])
  @@index([price])
  @@index([createdAt])
  @@index([soldCount])
  @@index([title])
  @@index([deletedAt])
  @@index([deletedByTaxonomy])
}

model ProductVariant {
  id            String   @id @default(uuid())
  productId     String
  name          String   @db.VarChar(120)
  sku           String?  @db.VarChar(120)
  color         String   @db.VarChar(7)
  images        Json
  priceOverride Decimal? @db.Decimal(10, 2)
  stock         Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([productId, isActive])
}

model ProductTag {
  productId String
  tagId     String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
  @@index([tagId])
}

// A discount targets a product, a category, or (both null) the whole store.
model Discount {
  id         String       @id @default(uuid())
  name       String
  type       DiscountType
  value      Decimal      @db.Decimal(10, 2)
  startsAt   DateTime?
  endsAt     DateTime?
  isActive   Boolean      @default(true)
  deletedAt  DateTime?
  productId  String?
  categoryId String?
  createdAt  DateTime     @default(now())
  product    Product?     @relation(fields: [productId], references: [id], onDelete: Cascade)
  category   Category?    @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([categoryId])
  @@index([deletedAt])
}

model Coupon {
  id              String       @id @default(uuid())
  code            String       @unique @db.VarChar(64)
  type            DiscountType
  value           Decimal      @db.Decimal(10, 2)
  minimumSubtotal Decimal?     @db.Decimal(10, 2)
  maxDiscount     Decimal?     @db.Decimal(10, 2)
  startsAt        DateTime?
  endsAt          DateTime?
  isActive        Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  deletedAt       DateTime?
  orders          Order[]

  @@index([isActive, startsAt, endsAt])
  @@index([deletedAt])
}

model Review {
  id          String       @id @default(uuid())
  productId   String
  userId      String?
  authorName  String
  authorEmail String?
  rating      Int
  title       String?
  body        String       @db.Text
  status      ReviewStatus @default(PENDING)
  createdAt   DateTime     @default(now())
  deletedAt   DateTime?
  product     Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  user        User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([productId, status])
  @@index([deletedAt])
}

model Cart {
  id        String     @id @default(uuid())
  userId    String     @unique
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
}

model CartItem {
  id         String          @id @default(uuid())
  cartId     String
  productId  String
  variantId  String?
  variantKey String          @default("")
  quantity   Int             @default(1)
  cart       Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product    Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant    ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@unique([cartId, productId, variantKey])
}

model WishlistItem {
  id        String   @id @default(uuid())
  userId    String
  productId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

model SavedAddress {
  id          String   @id @default(uuid())
  userId      String
  firstName   String
  lastName    String
  phone       String
  addressLine String   @db.Text
  city        String
  state       String
  country     String
  postalCode  String
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isDefault])
}

model Order {
  id                  String                   @id @default(uuid())
  userId              String
  status              OrderStatus              @default(PENDING)
  paymentMethod       PaymentMethod            @default(CASH_ON_DELIVERY)
  paymentStatus       PaymentStatus            @default(NOT_REQUIRED)
  subtotal            Decimal                  @db.Decimal(10, 2)
  discountTotal       Decimal                  @default(0) @db.Decimal(10, 2)
  couponId            String?
  couponCode          String?                  @db.VarChar(64)
  couponDiscount      Decimal                  @default(0) @db.Decimal(10, 2)
  total               Decimal                  @db.Decimal(10, 2)
  currency            String                   @default("INR")
  shippingName        String?
  shippingPhone       String?
  shippingAddress     String?                  @db.Text
  adminNote           String?                  @db.Text
  deliveryPartner     String?                  @db.VarChar(120)
  deliveryReferenceId String?                  @db.VarChar(120)
  deliveryTrackingUrl String?                  @db.VarChar(1000)
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  deletedAt           DateTime?
  user                User                     @relation(fields: [userId], references: [id])
  coupon              Coupon?                  @relation(fields: [couponId], references: [id], onDelete: SetNull)
  items               OrderItem[]
  deliveryAttempts    OrderDeliveryAttempt[]
  paymentAttempts     RazorpayPaymentAttempt[]
  invoice             Invoice?

  @@index([status, createdAt])
  @@index([userId])
  @@index([couponId])
  @@index([deletedAt])
}

model RazorpayPaymentAttempt {
  id                 String                @id @default(uuid())
  orderId            String
  razorpayOrderId    String?               @unique @db.VarChar(64)
  razorpayPaymentId  String?               @unique @db.VarChar(64)
  amount             BigInt
  currency           String                @db.VarChar(3)
  status             RazorpayAttemptStatus @default(CREATING)
  failureCode        String?               @db.VarChar(100)
  failureDescription String?               @db.Text
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  order              Order                 @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, status])
  @@index([createdAt])
}

model RazorpayWebhookEvent {
  id         String   @id @default(uuid())
  eventId    String   @unique @db.VarChar(191)
  eventType  String   @db.VarChar(100)
  receivedAt DateTime @default(now())
}

model Invoice {
  id             String             @id @default(uuid())
  sequence       Int                @unique @default(autoincrement())
  orderId        String             @unique
  recipientEmail String?            @db.VarChar(190)
  emailStatus    InvoiceEmailStatus @default(PENDING)
  emailAttempts  Int                @default(0)
  lastAttemptAt  DateTime?
  lastError      String?            @db.Text
  sentAt         DateTime?
  issuedAt       DateTime           @default(now())
  order          Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([emailStatus, lastAttemptAt])
}

model OrderDeliveryAttempt {
  id        String               @id @default(uuid())
  orderId   String
  outcome   OrderDeliveryOutcome
  notes     String?              @db.Text
  createdAt DateTime             @default(now())
  order     Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

model OrderItem {
  id            String          @id @default(uuid())
  orderId       String
  productId     String
  variantId     String?
  title         String
  variantName   String?         @db.VarChar(120)
  variantColor  String?         @db.VarChar(7)
  variantImages Json?
  unitPrice     Decimal         @db.Decimal(10, 2)
  quantity      Int
  order         Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product       Product         @relation(fields: [productId], references: [id])
  variant       ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
}

enum HighlightedPostMediaType {
  image
  video
}

model HighlightedPost {
  id        String                   @id @default(uuid())
  image     String                   @db.VarChar(1000)
  mediaType HighlightedPostMediaType @default(image)
  link      String                   @db.VarChar(1000)
  alt       String?
  sortOrder Int                      @default(0)
  createdAt DateTime                 @default(now())
  deletedAt DateTime?

  @@index([deletedAt])
}

model HeroBanner {
  id           String    @id @default(uuid())
  desktopImage String    @db.VarChar(1000)
  mobileImage  String?   @db.VarChar(1000)
  link         String    @db.VarChar(1000)
  alt          String?
  sortOrder    Int       @default(0)
  createdAt    DateTime  @default(now())
  deletedAt    DateTime?

  @@index([deletedAt])
}

model BlogArticle {
  id          String    @id @default(uuid()) @db.VarChar(36)
  slug        String    @unique @db.VarChar(160)
  title       String    @db.VarChar(255)
  category    String    @db.VarChar(60)
  publishedAt DateTime  @db.Date
  readTime    Int
  excerpt     String    @db.VarChar(320)
  image       String    @db.VarChar(1000)
  content     String    @db.LongText
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([category, publishedAt])
  @@index([publishedAt])
  @@index([deletedAt])
}

model HighlightedCategorySetting {
  id              String    @id
  image           String    @db.VarChar(1000)
  title           String    @db.VarChar(255)
  description     String    @db.Text
  buttonLink      String    @default("/products") @db.VarChar(1000)
  durationSeconds Int       @default(259200)
  isEnabled       Boolean   @default(true)
  autoRestart     Boolean   @default(false)
  timerEndsAt     DateTime?
  updatedAt       DateTime  @updatedAt
}

model ContactPageSetting {
  id                 String   @id @default("contact-us") @db.VarChar(40)
  heading            String   @default("GET IN TOUCH") @db.VarChar(120)
  tagline            String   @default("Have a question about our products or your order? We'd love to hear from you.") @db.VarChar(500)
  contactHeading     String   @default("We're always close by.") @db.VarChar(200)
  contactIntro       String   @db.Text
  email              String   @default("support@youniqlyf.com") @db.VarChar(190)
  alternateEmail     String?  @db.VarChar(190)
  phone              String   @default("+91 9871777077") @db.VarChar(40)
  whatsapp           String?  @default("+91 9871777077") @db.VarChar(40)
  supportTitle       String   @default("Customer Support") @db.VarChar(120)
  supportDescription String   @default("For help with bags and accessories, order updates, and returns.") @db.VarChar(500)
  image              String?  @db.VarChar(1000)
  imageAlt           String   @default("Youniqlyf customer support") @db.VarChar(255)
  updatedAt          DateTime @updatedAt
}

model ContactLocation {
  id        String    @id @default(uuid())
  slug      String    @unique @db.VarChar(160)
  city      String    @db.VarChar(120)
  country   String    @db.VarChar(120)
  company   String?   @db.VarChar(190)
  address   String    @db.Text
  phone     String?   @db.VarChar(40)
  whatsapp  String?   @db.VarChar(40)
  sortOrder Int       @default(0)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([isActive, sortOrder])
  @@index([deletedAt])
}

model ContactFaq {
  id        String         @id @default(uuid())
  question  String         @db.VarChar(500)
  answer    String         @db.Text
  page      ContactFaqPage @default(FAQ_PAGE)
  sortOrder Int            @default(0)
  isActive  Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  deletedAt DateTime?

  @@index([isActive, sortOrder])
  @@index([page, isActive, sortOrder])
  @@index([deletedAt])
}

model PolicyPageContent {
  slug      String   @id @db.VarChar(100)
  content   String   @db.LongText
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ContactSubmission {
  id        String    @id @default(uuid())
  fullName  String    @db.VarChar(100)
  phone     String    @db.VarChar(30)
  email     String    @db.VarChar(190)
  subject   String    @db.VarChar(80)
  message   String    @db.Text
  consent   Boolean   @default(true)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([readAt, createdAt])
  @@index([createdAt])
}

model PartnerRequest {
  id          String          @id @default(uuid())
  fullName    String          @db.VarChar(100)
  countryCode String          @db.VarChar(4)
  phoneNumber String          @db.VarChar(15)
  interest    PartnerInterest
  createdAt   DateTime        @default(now())

  @@index([createdAt])
  @@index([fullName])
}

model CareerApplication {
  id                String        @id @default(uuid())
  fullName          String        @db.VarChar(100)
  email             String        @db.VarChar(190)
  countryCode       String        @db.VarChar(4)
  phoneNumber       String        @db.VarChar(15)
  jobRole           CareerJobRole
  resumePublicId    String        @db.VarChar(255)
  resumeFileName    String        @db.VarChar(255)
  resumeContentType String        @db.VarChar(100)
  consentAt         DateTime      @default(now())
  createdAt         DateTime      @default(now())

  @@index([createdAt])
  @@index([fullName])
  @@index([email])
}

model CareerPageSetting {
  id        String   @id @default("careers") @db.VarChar(40)
  imageUrl  String?  @db.VarChar(1000)
  updatedAt DateTime @updatedAt
}

model AboutUsPageSetting {
  id                    String                 @id @default("about-us") @db.VarChar(40)
  heroHeading           String                 @db.VarChar(255)
  heroDescription       String                 @db.VarChar(1000)
  desktopImage          String?                @db.VarChar(1000)
  mobileImage           String?                @db.VarChar(1000)
  journeyHeading        String                 @db.VarChar(200)
  journeyDescription    String                 @db.VarChar(1000)
  principlesHeading     String                 @default("Our approach to everyday style.") @db.VarChar(255)
  whoImage              String?                @db.VarChar(1000)
  whoHeading            String                 @default("WHO WE ARE") @db.VarChar(200)
  whoSubheading         String                 @default("Bags and accessories to make your look your own") @db.VarChar(255)
  whoParagraph1         String?                @db.Text
  whoParagraph2         String?                @db.Text
  whoParagraph3         String?                @db.Text
  whoParagraph4         String?                @db.Text
  whoBadge              String                 @default("STYLE YOUR WAY") @db.VarChar(120)
  legacyImage           String?                @db.VarChar(1000)
  legacyHeading         String                 @default("BAGS & ACCESSORIES FOR YOUR EVERYDAY") @db.VarChar(255)
  legacyIntro           String?                @db.Text
  legacyParagraph1      String?                @db.Text
  legacyParagraph2      String?                @db.Text
  whyChooseImage        String?                @db.VarChar(1000)
  whyChooseHeading      String                 @default("WHY CHOOSE YOUNIQLYF?") @db.VarChar(255)
  whyChooseDescription  String?                @db.Text
  milestone1Year        String                 @db.VarChar(40)
  milestone1Title       String                 @db.VarChar(160)
  milestone1Description String                 @db.VarChar(500)
  milestone2Year        String                 @db.VarChar(40)
  milestone2Title       String                 @db.VarChar(160)
  milestone2Description String                 @db.VarChar(500)
  milestone3Year        String                 @db.VarChar(40)
  milestone3Title       String                 @db.VarChar(160)
  milestone3Description String                 @db.VarChar(500)
  milestone4Year        String                 @db.VarChar(40)
  milestone4Title       String                 @db.VarChar(160)
  milestone4Description String                 @db.VarChar(500)
  updatedAt             DateTime               @updatedAt
  principles            AboutUsPrinciple[]
  legacyStats           AboutUsLegacyStat[]
  whyChooseCards        AboutUsWhyChooseCard[]
}

model AboutUsPrinciple {
  id            String             @id @default(uuid()) @db.VarChar(36)
  pageSettingId String             @db.VarChar(40)
  icon          String             @db.VarChar(1000)
  title         String             @db.VarChar(160)
  description   String             @db.VarChar(1000)
  sortOrder     Int                @default(0)
  deletedAt     DateTime?
  pageSetting   AboutUsPageSetting @relation(fields: [pageSettingId], references: [id], onDelete: Cascade)

  @@index([pageSettingId, sortOrder])
  @@index([deletedAt])
}

model AboutUsLegacyStat {
  id            String             @id @default(uuid()) @db.VarChar(36)
  pageSettingId String             @db.VarChar(40)
  icon          String             @db.VarChar(1000)
  title         String             @db.VarChar(160)
  sortOrder     Int                @default(0)
  deletedAt     DateTime?
  pageSetting   AboutUsPageSetting @relation(fields: [pageSettingId], references: [id], onDelete: Cascade)

  @@index([pageSettingId, sortOrder])
  @@index([deletedAt])
}

model AboutUsWhyChooseCard {
  id            String             @id @default(uuid()) @db.VarChar(36)
  pageSettingId String             @db.VarChar(40)
  title         String             @db.VarChar(160)
  description   String             @db.VarChar(1000)
  sortOrder     Int                @default(0)
  deletedAt     DateTime?
  pageSetting   AboutUsPageSetting @relation(fields: [pageSettingId], references: [id], onDelete: Cascade)

  @@index([pageSettingId, sortOrder])
  @@index([deletedAt])
}
